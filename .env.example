# Copy this file to .env and replace the placeholder with your SumoPod key.
# All model requests use https://ai.sumopod.com/v1.
API_KEY=your_sumopod_api_key_here
# CHAT_MODEL overrides MODEL when both are set.
MODEL=glm-5.3-flash
LLM_TEMPERATURE=0.7
# Optional response limit. The app defaults to 1024 tokens.
# CHAT_MAX_TOKENS=150
EMBEDDING_MODEL=text-embedding-3-small
# Match the returned size and rerun ingestion after changing the embedding setup.
EMBEDDING_DIMENSIONS=1536
# Enable only if the endpoint accepts custom dimensions.
# EMBEDDING_SEND_DIMENSIONS=true

# Set the exact ID of a SumoPod audio transcription model available to your account.
# Leave blank for text chat, dataset preview, and saved checkpoint inspection.
ASR_MODEL=

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=test-ai-nlp
# Set this separately for an authenticated Qdrant cluster.
# QDRANT_API_KEY=

# Optional benchmark overrides. DATASET_REVISION must be a full commit SHA.
# DATASET_REVISION=40ce77cb32a384e4d50a568e1ec39ac804019d33
# EVALUATION_SEED=42
# RESULTS_DIR=results
